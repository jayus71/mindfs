# Copy outside the checkout. These are paths and IDs, never API keys.
MINDFS_CONTAINER_HOME=/absolute/private/mindfs-container-home
MINDFS_PROJECT_DIR=/absolute/path/to/one/project
MINDFS_CONTAINER_PORT=7332
# compose.sh defaults these to the current host uid/gid.
# MINDFS_UID=1000
# MINDFS_GID=1000
# Optional: complete private release, not ~/.local/bin/rcc (which may be a wrapper).
# RCC_RELEASE_DIR=/absolute/private/rcc-release
# RCC_NODE_ID=an-already-authorized-external-node
